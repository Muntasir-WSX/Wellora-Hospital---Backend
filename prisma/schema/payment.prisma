model Payment {
  id String @id @default(uuid())

  status PaymentStatus @default(UNPAID)

  amount   Decimal @db.Decimal(10, 2) // 100.50
  currency String  @default("BDT")

  paymentGateway        PaymentGateway @default(BKASH)
  merchantInvoiceNumber String         @unique // appointment id

  bkashPaymentId String?   @unique
  bkashTrxId     String?
  payerReference String? // user email / phone number
  paidAt         DateTime?

  gatewayResponse Json?

  refundTrxId  String?
  refundAmount Decimal?  @db.Decimal(10, 2)
  refundReason String?
  refundedAt   DateTime?

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

enum PaymentGateway {
  BKASH
  SSLCOMMERZ
}
