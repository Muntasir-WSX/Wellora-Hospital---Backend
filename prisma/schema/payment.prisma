model Payment {
  id String @id @default(uuid())

  status PaymentStatus @default(UNPAID)

  amount   Decimal @db.Decimal(10, 2) // 100.50
  currency String  @default("BDT")

  paymentGateway        PaymentGateway @default(SSLCOMMERZ)
  merchantInvoiceNumber String         @unique

  gatewayPaymentId     String?   @unique
  gatewayTransactionId String?
  payerReference       String? // user email / phone number
  paidAt               DateTime?

  gatewayResponse Json?

  gatewayRefundId String?
  refundAmount    Decimal?  @db.Decimal(10, 2)
  refundReason    String?
  refundedAt      DateTime?

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

enum PaymentGateway {
  SSLCOMMERZ
  LEGACY
}
